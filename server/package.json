{
  "name": "linguapath-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && node --watch dist/src/main.js",
    "start": "node dist/src/main.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "providers:verify": "npm run build && node dist/src/provider-adapters/verify-main.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "music-metadata": "12.3.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tencentcloud-sdk-nodejs-asr": "4.1.335",
    "tencentcloud-sdk-nodejs-tts": "4.1.335",
    "undici": "7.30.1"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/multer": "2.0.0",
    "@types/node": "22.18.6",
    "typescript": "5.7.3"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "2.5.0"
    },
    "tencentcloud-sdk-nodejs-common": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": ">=22.8.0"
  }
}
